# ═══════════════════════════════════════════════════════════════════════════
#  GNASchools LMS — environment template
#  Copy to `.env.local` (git-ignored) and fill in.  `.env.local` overrides
#  `.env`, and both are ignored by git; only this template is committed.
# ═══════════════════════════════════════════════════════════════════════════

# ── Client (browser) ────────────────────────────────────────────────────────
# ONLY variables prefixed with VITE_ reach the browser bundle. Everything here
# is public by definition — never put a secret behind a VITE_ prefix.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# Local development (supabase start): http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon / publishable key. Safe to ship: it carries no privileges of
# its own — every request it makes is still evaluated against RLS.
VITE_SUPABASE_ANON_KEY=

# Free-text label shown in the UI and attached to error reports.
# One of: local | development | staging | production
VITE_APP_ENV=local

# Public origin the SPA is served from. Used to build the redirect URLs handed
# to Supabase for email verification and password reset.
VITE_APP_URL=http://localhost:5173

# Optional: base URL for the REST facade used by the Axios client (Edge
# Functions gateway). Defaults to `${VITE_SUPABASE_URL}/functions/v1`.
VITE_API_BASE_URL=

# Feature flags — "true" / "false".
VITE_ENABLE_REALTIME=true
VITE_ENABLE_DEVTOOLS=true

# Dev-server ports (optional).
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173

# ═══════════════════════════════════════════════════════════════════════════
#  Server-side only — NEVER prefix these with VITE_.
#  Used by the Supabase CLI, Edge Functions and CI. Vite will refuse to inline
#  them, and `src/shared/lib/env.ts` asserts at boot that none leaked.
# ═══════════════════════════════════════════════════════════════════════════

# Supabase project ref (the subdomain of your project URL). Used by
# `npm run db:types:remote` and by CI deploys.
SUPABASE_PROJECT_ID=

# Service-role key. Full bypass of RLS. Server/CI only. If this ever appears
# in a browser bundle, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token for the Supabase CLI in CI (supabase login --token).
SUPABASE_ACCESS_TOKEN=

# Database password, for `supabase db push` against a linked project.
SUPABASE_DB_PASSWORD=

# ── Edge Function secrets (supabase/functions/.env) ─────────────────────────
# Transactional email provider used by the `send-notification-email` function.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=GNASchools LMS <no-reply@gnaschools.example>

# Shared secret required by scheduled functions so only the scheduler can
# invoke them. Generate with: openssl rand -hex 32
FUNCTION_CRON_SECRET=
