# Secrets for `supabase functions serve --env-file supabase/functions/.env`.
# In production set these with:  supabase secrets set --env-file ./supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# the platform at runtime — do not set them here for a deployed function.

# Comma-separated origins allowed to call the functions from a browser.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Public origin of the SPA, used to build links inside emails.
APP_URL=http://localhost:5173

# Resend (https://resend.com). Leave unset to disable outbound email — the
# functions degrade to in-app notifications only.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=GNASchools LMS <no-reply@gnaschools.example>

# Shared secret for scheduler-invoked functions. Generate with:
#   openssl rand -hex 32
FUNCTION_CRON_SECRET=
